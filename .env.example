# =============================================================================
# BotStoreTelegram — Cấu hình Môi trường (.env)
# =============================================================================

# Server & Deployment
APP_ENV=development
HOST=0.0.0.0
PORT=10000
# URL công khai của Render (hoặc ngrok khi chạy local để mở Telegram Mini App & nhận PayOS Webhook)
# Ví dụ: https://bot-gemini-store.onrender.com
PUBLIC_BASE_URL=https://your-service.onrender.com
RUST_LOG=info,bot_store_telegram=debug,sqlx=warn

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bot_store_telegram
DB_MAX_CONNECTIONS=10

# Telegram Bot Configuration
# Lấy từ @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chế độ chạy bot: "polling" (chạy local dev) hoặc "webhook" (chạy production trên Render)
BOT_MODE=polling
# Chuỗi bí mật bất kỳ (chỉ gồm A-Z, a-z, 0-9, _, -) dùng để xác thực Webhook Telegram
TELEGRAM_WEBHOOK_SECRET=change_me_telegram_webhook_secret_32chars
# Telegram User ID của Admin (lấy từ @userinfobot) để nhận thông báo khi có đơn mới
ADMIN_TELEGRAM_ID=123456789
# Username hỗ trợ hiển thị trong tin nhắn Bot
SUPPORT_HANDLE=@kim12ad

# Security Keys
# Khóa AES-256-GCM dạng hex đúng 64 ký tự (= 32 bytes) để mã hóa Mail|Pass|2FA trong PostgreSQL
# Sinh nhanh bằng: openssl rand -hex 32
CREDENTIALS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Khóa bảo vệ REST API Admin (/api/v1/admin/*) qua header X-Admin-Api-Key
ADMIN_API_KEY=change_me_super_secret_admin_api_key

# PayOS Payment Gateway (https://my.payos.vn)
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_BASE_URL=https://api-merchant.payos.vn

# Referral Reward (VND thưởng cho người giới thiệu khi người mới nạp tiền lần đầu)
REFERRAL_REWARD_VND=5000
